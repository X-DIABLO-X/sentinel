# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.env.local

# NETRA live database (regenerated at runtime, not source)
CCTV/results/*.db
CCTV/results/*.db-shm
CCTV/results/*.db-wal
CCTV/netra.db
CCTV/netra.db-shm
CCTV/netra.db-wal

# Ultralytics local runtime cache — contains this machine's absolute paths,
# regenerates automatically on first run for anyone.
CCTV/.runtime/

# OSM road-graph cache — regenerated on first response.py call, large binary,
# not source.
CCTV/results/cache/

# Per-run analysis reports (regenerated by `run.py process`), not source.
# (pattern is `dir/*`, not `dir/` -- git cannot re-include anything inside a
# directory that was itself excluded, so the negation below would never apply)
CCTV/reports/*
# ...except the cached calibration first-frames. Unlike the run reports these
# CANNOT be regenerated from a clone: /api/cameras/{id}/frame extracts them
# from the source clips, which are not redistributed here (see CCTV/DATA.md).
# Committing them is what makes the Calibrate and CCTV screens work for
# anyone who checks this repo out. ~3.5MB for the 30 cameras whose footage
# was available to generate them from.
!CCTV/reports/frame_*.jpg

# Per-incident evidence images/clips written by EvidenceWriter on every run
# (regenerated by run.py process / run_problems.py, not source) — the small
# number of curated evidence images actually referenced by README.md are
# copied into docs/assets/ instead, which IS committed.
CCTV/evidence/

# Browser-compatible video/poster cache for /api/problem-videos and
# /api/demo-videos (regenerated on first request per clip, not source).
CCTV/uploads/

# Weight files ultralytics auto-downloads to cwd if a run script doesn't
# point at models/ explicitly — the real copies live in CCTV/models/.
CCTV/*.pt

# Raw source video copies used transiently for rendering — only the
# physics-annotated OUTPUT videos are committed, never the raw inputs.
# (See README §10 — DEMO/CCTV physics_reference dirs hold the real assets.)
CCTV/demo/*_3840_2160_30fps.mp4
CCTV/demo/*_1920_1080_30fps.mp4

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
APP/tsconfig.tsbuildinfo
