# Copy to .env.local and adjust if either backend runs on a non-default port.
#
# CCTV (NETRA) FastAPI process — FINAL/CCTV, `python run.py serve`
NEXT_PUBLIC_CCTV_API=http://localhost:8000
#
# DRONE FastAPI process — FINAL/DRONE. This is a SEPARATE process on a
# separate port by design (see FINAL/APP/README.md). FINAL/DRONE ships no
# api.py yet, so the drone page renders its offline state until one exists.
NEXT_PUBLIC_DRONE_API=http://localhost:8011
